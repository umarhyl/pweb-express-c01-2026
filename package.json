{
  "name": "pweb-express-c01-2026",
  "version": "1.0.0",
  "description": "MLBB Shop Backend - Express 5 + Prisma 7 + Neon",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
